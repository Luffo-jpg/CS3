class Patient:
    _name = ""
    _bill_amount = 0.0

    def __init__(self, name, bill_amount):
        self._name = name
        self._bill_amount = bill_amount

    def get_name(self):
        return self._name

    def set_name(self, name):
        self._name = name

    def get_bill_amount(self):
        return self._bill_amount

    def set_bill_amount(self, bill_amount):
        self._bill_amount = bill_amount

    def calculate_bill(self):
        print("Original bill: P" + str(self._bill_amount))
        print("Final Bill: P" + str(self._bill_amount))

    def display_patient_type(self):
        return "Regular Patient"


class SeniorPatient(Patient):
    def calculate_bill(self):
        self.finalBill = self._bill_amount * 0.8
        print("Original bill: P" + str(self._bill_amount))
        print("Final Bill: P" + str(self.finalBill))

    def display_patient_type(self):
        return "Senior Patient"


